# Binance Trading Dashboard - Backend Environment Configuration
PORT=5000

# Optional Server-level Binance API Credentials
# NOTE: Users can also input keys securely in the Dashboard UI at runtime.
# SECURITY CRITICAL:
# 1. Never commit real keys to Git or share publicly.
# 2. Permissions required: Enable "Read" and "Enable Spot & Margin Trading".
# 3. STRICTLY DISABLE "Enable Withdrawals" - your keys should NEVER have withdrawal rights!
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Set to 'true' to use Binance Spot Testnet (https://testnet.binance.vision)
# Set to 'false' to connect to live Binance Production (https://api.binance.com)
USE_TESTNET=true

